# 复制为 .env.local 后按需填写；不要提交任何真实密钥。
# 运行模式：demo 使用演示数据；production 只使用已通过质量检查的真实数据。
LITERATURE_MODE=demo
DEPLOY_ENV=local
SITE_URL=http://localhost:3000
SITE_BASE_PATH=

# Production 中 AI_API_KEY 只能保存在 GitHub Actions Secrets。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=7000
AI_TIMEOUT=90000
AI_RETRY_COUNT=1

# 可选：本地配置加密主密钥。留空时会在 data/private 自动生成仅本机可读的密钥。
AI_CONFIG_MASTER_KEY=
AI_ADMIN_API_PORT=4317

# NCBI：API Key 可选；不配置时请保持较低请求频率
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=anesthesia_literature_daily

# Crossref polite pool（建议与 NCBI_EMAIL 相同）
CROSSREF_MAILTO=

# 每日任务与费用保护
DAILY_ARTICLE_COUNT=5
DAILY_MAX_CANDIDATES=2000
DAILY_CANDIDATE_PAGE_SIZE=200
DAILY_JOURNAL_AUDIT_LIMIT=300
PUBMED_FETCH_BATCH_SIZE=150
DAILY_AI_CALL_LIMIT=50
DAILY_TOKEN_LIMIT=500000
DAILY_MAX_INPUT_CHARS=60000

# 邮件订阅（可选）。当前推荐Buttondown；腾讯云SES配置作为以后有域名时的备用。
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=buttondown
BUTTONDOWN_API_KEY=
BUTTONDOWN_API_BASE_URL=https://api.buttondown.com/v1
BUTTONDOWN_TIMEOUT=30000
BUTTONDOWN_RETRY_COUNT=3
BUTTONDOWN_SUBSCRIBER_LIMIT=100
NEXT_PUBLIC_BUTTONDOWN_USERNAME=

# 腾讯云SES备用模式：EMAIL_PROVIDER=tencent-ses时才使用以下配置。
NEXT_PUBLIC_SUBSCRIPTION_EMAIL=
SUBSCRIBER_ENCRYPTION_KEY=

# 专用收件邮箱：接收“订阅 / 确认订阅 / 退订”指令。推荐单独申请一个QQ邮箱并开启IMAP授权码。
SUBSCRIPTION_INBOX_IMAP_HOST=imap.qq.com
SUBSCRIPTION_INBOX_IMAP_PORT=993
SUBSCRIPTION_INBOX_IMAP_SECURE=true
SUBSCRIPTION_INBOX_MAILBOX=INBOX
SUBSCRIPTION_INBOX_USER=
SUBSCRIPTION_INBOX_PASSWORD=

# 腾讯云邮件推送SES。SecretId/SecretKey必须使用最小权限子账号密钥。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=
TENCENT_SES_REPLY_TO=
TENCENT_SES_DAILY_TEMPLATE_ID=
TENCENT_SES_NOTICE_TEMPLATE_ID=
TENCENT_SES_TIMEOUT=30000

# 邮件费用和异常群发保护
EMAIL_DAILY_SEND_LIMIT=120
EMAIL_SEND_DELAY_MS=150
EMAIL_MONTHLY_COST_LIMIT_CNY=20
