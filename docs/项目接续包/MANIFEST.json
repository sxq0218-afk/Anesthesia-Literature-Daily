{
  "project": "每日麻醉文献精读",
  "englishName": "Anesthesia Literature Daily",
  "repository": "sxq0218-afk/Anesthesia-Literature-Daily",
  "defaultBranch": "main",
  "generatedAt": "2026-07-23",
  "continuationEntry": "docs/项目接续包/README.md",
  "resumePrompt": "docs/项目接续包/RESUME_PROMPT.md",
  "runtime": {
    "node": ">=22.13.0",
    "framework": "Next.js 16",
    "contentMode": "static JSON and static export"
