    "preferredWindowDays": 30,
    "expandedWindowDays": 180,
    "dailyMaximum": 5,
    "clinicalTarget": 4,
    "basicTarget": 1,
    "priorityJournalTarget": 3,
    "minimumScore": 45,
    "minimumImpactFactorExclusive": 5,
    "titleSimilarityThreshold": 0.88,
    "permanentHistoryStatus": "published"
  },
  "requiredChecks": [
    "npm run test:literature",
    "npm run test:email",
    "npm run test:deployment",
    "npm run security:scan",
    "npm run build:edgeone"
  ],
  "containsSecrets": false
